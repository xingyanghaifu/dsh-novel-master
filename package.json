{
  "name": "dsh-novel-master",
  "version": "1.4.2",
  "description": "小说创作插件 for DeepSeek Harness - 29 个功能命令及更新入口，分组开关、模型隔离学习、决策 AI 与配置热更新",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "client.js",
    "preset/",
    "examples/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/INTELLIGENCE_REQUIREMENTS.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingyanghaifu/dsh-novel-master.git"
  },
  "bugs": {
    "url": "https://github.com/xingyanghaifu/dsh-novel-master/issues"
  },
  "homepage": "https://github.com/xingyanghaifu/dsh-novel-master#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "novel",
    "writing",
    "ai-writing",
    "chinese-novel",
    "web-novel",
    "conflict-analysis",
    "pace-analysis",
    "virtual-reader",
    "dialogue-enhancement",
    "emotion-tracking",
    "market-analysis",
    "creative-writing",
    "小说"
  ],
  "author": "xingyanghaifu <3174332008@qq.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "cordis": {
    "description": "小说创作大师：配置热更新、写作分析、章节工具、备份恢复与更新拉取",
    "service": {
      "required": [
        "commands"
      ],
      "optional": [
        "goals",
        "llm",
        "tools",
        "sessionController"
      ]
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "undici": "^7.16.0"
  }
}
